<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.velora</groupId>
    <artifactId>Velora-Motors</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <exec.mainClass>com.velora.Velora_Motors</exec.mainClass>

        <junit.version>5.10.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>

                <executions>

                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>report</id>
                        <phase>test</phase>

                        <goals>
                            <goal>report</goal>
                        </goals>

                        <configuration>
                            <excludes>

                                <exclude>com/velora/ui/AdminFooter*</exclude>
                                <exclude>com/velora/ui/AdminSupportInboxPanel*</exclude>
                                <exclude>com/velora/ui/AnalyticsPanel*</exclude>
                                <exclude>com/velora/ui/BillingPanel*</exclude>
                                <exclude>com/velora/ui/CustomerBillingPanel*</exclude>
                                <exclude>com/velora/ui/CustomerDashboard*</exclude>
                                <exclude>com/velora/ui/CustomerFooter*</exclude>
                                <exclude>com/velora/ui/FarewellScreen*</exclude>
                                <exclude>com/velora/ui/LoginScreen*</exclude>
                                <exclude>com/velora/ui/LogoutConfirmDialog*</exclude>
                                <exclude>com/velora/ui/LoyaltyPointsPanel*</exclude>
                                <exclude>com/velora/ui/MaintenancePanel*</exclude>
                                <exclude>com/velora/ui/ManagerDashboard*</exclude>
                                <exclude>com/velora/ui/MyRentalsPanel*</exclude>
                                <exclude>com/velora/ui/ProfilePanel*</exclude>
                                <exclude>com/velora/ui/RentalReturnPanel*</exclude>
                                <exclude>com/velora/ui/ReviewsPanel*</exclude>
                                <exclude>com/velora/ui/SplashScreen*</exclude>
                                <exclude>com/velora/ui/SupportPanel*</exclude>
                                <exclude>com/velora/ui/VehicleCatalog*</exclude>
                                <exclude>com/velora/ui/VehicleDetails*</exclude>
                                <exclude>com/velora/ui/VeloraNotificationDialog*</exclude>
                                <exclude>com/velora/ui/VeloraTheme*</exclude>

                            </excludes>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>

        </plugins>
    </build>

</project>