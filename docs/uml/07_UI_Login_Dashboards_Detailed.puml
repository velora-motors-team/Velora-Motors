    -{static} BG_1 : Color
    -{static} BG_2 : Color
    -{static} BG_3 : Color
    -{static} TEXT_MAIN : Color
    -{static} TEXT_MUTED : Color
    -{static} TEXT_SOFT : Color
    --
    +LogoutConfirmDialog(JFrame)
    +isConfirmed() : boolean
    +setVisible(boolean) : void
  }
  class "ManagerDashboard" as com_velora_ui_ManagerDashboard {
    -{static} BACKGROUND : Color
    -{static} SIDEBAR : Color
    -{static} CARD : Color
    -{static} CARD_LIGHT : Color
    -{static} GOLD : Color
    -{static} PALE : Color
    -{static} TEXT : Color
    -{static} MUTED : Color
    -{static} GREEN : Color
    -{static} RED : Color
    -manager : Customer
    -vehicleService : VehicleService
    -pricingService : RentalPricingService
    -authenticationService : AuthenticationService
    -ratingRepository : RatingRepository
    -waitlistRepository : VehicleWaitlistRepository
    -menuButtons : Map<String, ManagerDashboard.MenuButton>
    -contentLayout : CardLayout
    -contentCards : JPanel
    -root : ManagerDashboard.DashboardBackground
    -billingPanel : BillingPanel
    -analyticsPanel : AnalyticsPanel
    -adminSupportInboxPanel : AdminSupportInboxPanel
    -rentalReturnPanel : RentalReturnPanel
    -sidebar : JPanel
    -searchField : JTextField
    -vehiclePageSearchField : JTextField
    -vehicleCategoryFilter : JComboBox<String>
