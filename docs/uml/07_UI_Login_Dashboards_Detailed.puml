    -mailIcon : CustomerDashboard.TopBadgeIcon
    -myRentalsPanel : MyRentalsPanel
    -loyaltyPointsPanel : LoyaltyPointsPanel
    -iconImage : image.BufferedImage
    -heroImage : image.BufferedImage
    -rentalCard1 : image.BufferedImage
    -rentalCard2 : image.BufferedImage
    -rentalCard3 : image.BufferedImage
    --
    +CustomerDashboard(Customer)
    +showVehicleCatalog() : void
    +showAvailabilityToast() : void
  }
  class "CustomerFooter" as com_velora_ui_CustomerFooter {
    -{static} BACKGROUND : Color
    -{static} BORDER : Color
    -{static} GOLD : Color
    -{static} TEXT : Color
    -{static} MUTED : Color
    --
    ~CustomerFooter()
    #paintComponent(Graphics) : void
  }
  class "FarewellScreen" as com_velora_ui_FarewellScreen {
    -{static} GOLD : Color
    -{static} GOLD_LIGHT : Color
    -progress : int
    -loadingTimer : Timer
    -canvas : FarewellScreen.FarewellCanvas
    -restoreBounds : Rectangle
    --
    +{static} main(String[]) : void
    +FarewellScreen(String)
  }
  class "LoginScreen" as com_velora_ui_LoginScreen {
    +LoginScreen()
    +{static} main(String[]) : void
  }
  class "LogoutConfirmDialog" as com_velora_ui_LogoutConfirmDialog {
    -confirmed : boolean
    -{static} W : int
    -{static} H : int
    -{static} ARC : int
    -{static} GOLD : Color
    -{static} GOLD_LIGHT : Color
