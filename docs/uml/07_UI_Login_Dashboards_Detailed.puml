@startuml
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
hide circle

title UI - Login and Dashboards

package "authentication" {
  class "Customer" as com_velora_authentication_Customer
}

package "repository" {
  class "NotificationRepository" as com_velora_repository_NotificationRepository
  class "RatingRepository" as com_velora_repository_RatingRepository
  class "RentalRepository" as com_velora_repository_RentalRepository
  class "VehicleWaitlistRepository" as com_velora_repository_VehicleWaitlistRepository
}

package "service" {
  class "AuthenticationService" as com_velora_service_AuthenticationService
  class "RentalExpiryReminderService" as com_velora_service_RentalExpiryReminderService
  class "RentalPricingService" as com_velora_service_RentalPricingService
  class "VehicleService" as com_velora_service_VehicleService
}

package "ui" {
  class "AdminFooter" as com_velora_ui_AdminFooter {
    -{static} BACKGROUND : Color
    -{static} BORDER : Color
    -{static} GOLD : Color
    -{static} TEXT : Color
    -{static} MUTED : Color
    --
    ~AdminFooter()
    #paintComponent(Graphics) : void
  }
  class "CustomerAccountState" as com_velora_ui_CustomerAccountState {
    -{static} STATES : Map<String, CustomerAccountState>
    -{static} STARTING_POINTS : int
    -{static} STARTING_REWARDS_USED : int
    -{static} STARTING_WALLET_BALANCE : double
    -{static} STORE_DIR : Path
    -{static} persistedStatesLoaded : boolean
    -invoices : List<CustomerAccountState.CustomerInvoice>
    -listeners : List<CustomerAccountState.ChangeListener>
    -storageKey : String
    -redeemedPoints : int
    -redeemedRewards : int
    -pendingRentalDiscounts : int
    -walletBalance : double
    --
    ~{static} forCustomer(Customer) : CustomerAccountState
    ~{static} billingMetricsSnapshot() : BillingMetricsBus.Metrics
    ~addChangeListener(CustomerAccountState.ChangeListener) : void
    ~getInvoices() : List<CustomerAccountState.CustomerInvoice>
    ~applyLateFee(String, double) : CustomerAccountState.LateFeeChargeResult
    ~isInvoiceFullyPaid(String) : boolean
    ~addInvoice(CustomerAccountState.CustomerInvoice) : void
    ~adjustWalletBalance(double) : boolean
    ~recordPayment(CustomerAccountState.CustomerInvoice, String) : boolean
    ~addPaidInvoice(CustomerAccountState.CustomerInvoice, String) : boolean
    ~addPaidInvoice(CustomerAccountState.CustomerInvoice, String, boolean) : boolean
    ~getWalletBalance() : double
    ~canAfford(double) : boolean
    ~addWalletFunds(double) : void
    ~redeemReward(int) : boolean
    ~redeemReward(String, int) : boolean
    ~hasRentalDiscountReward() : boolean
    ~getPendingRentalDiscounts() : int
    ~getTotalRentals() : int
    ~getActiveRentals() : int
    ~getCompletedRentals() : int
    ~getLateReturns() : int
    ~getPaidInvoices() : long
    ~getPendingPayments() : long
    ~getTotalSpent() : double
    ~getOutstandingBalance() : double
    ~getLateFees() : double
    ~getLoyaltyPoints() : int
    ~getRewardsUsed() : int
    ~getTierName() : String
    ~getPointsToNextTier() : int
    ~getNextTierName() : String
    ~{static} resolveCustomerName(Customer) : String
    ~{static} createInvoice(Customer, int, String, int, double, double, String, String) : CustomerAccountState.CustomerInvoice
    ~{static} createInvoice(Customer, int, String, int, double, double, String, String, LocalDateTime, LocalDateTime) : CustomerAccountState.CustomerInvoice
  }
  class "CustomerDashboard" as com_velora_ui_CustomerDashboard {
    -{static} GOLD : Color
    -{static} GOLD_LIGHT : Color
    -{static} TEXT : Color
    -{static} MUTED : Color
    -{static} LINE : Color
    -customer : Customer
    -accountState : CustomerAccountState
    -notificationRepository : NotificationRepository
    -rentalExpiryReminderService : RentalExpiryReminderService
    -pageLayout : CardLayout
    -pageCards : JPanel
    -menuButtons : Map<String, CustomerDashboard.MenuButton>
    -vehicleCatalog : VehicleCatalog
    -supportPanel : SupportPanel
