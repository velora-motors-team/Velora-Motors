  }
  class "SplashScreen" as com_velora_ui_SplashScreen {
    +SplashScreen(Customer)
    +{static} main(String[]) : void
  }
}

package "vehicle" {
  abstract class "Vehicle" as com_velora_vehicle_Vehicle
}

com_velora_ui_CustomerDashboard --> com_velora_authentication_Customer : customer
com_velora_ui_CustomerDashboard --> com_velora_ui_CustomerAccountState : accountState
com_velora_ui_CustomerDashboard --> com_velora_repository_NotificationRepository : notificationRepository
com_velora_ui_CustomerDashboard --> com_velora_service_RentalExpiryReminderService : rentalExpiryReminderService
com_velora_ui_ManagerDashboard --> com_velora_authentication_Customer : manager
com_velora_ui_ManagerDashboard --> com_velora_service_VehicleService : vehicleService
com_velora_ui_ManagerDashboard --> com_velora_service_RentalPricingService : pricingService
com_velora_ui_ManagerDashboard --> com_velora_service_AuthenticationService : authenticationService
com_velora_ui_ManagerDashboard --> com_velora_repository_RatingRepository : ratingRepository
com_velora_ui_ManagerDashboard --> com_velora_repository_VehicleWaitlistRepository : waitlistRepository
com_velora_ui_ManagerDashboard ..> com_velora_vehicle_Vehicle : uses
com_velora_ui_ProfilePanel --> com_velora_authentication_Customer : customer
com_velora_ui_ProfilePanel --> com_velora_service_AuthenticationService : authenticationService
com_velora_ui_ProfilePanel --> com_velora_repository_RentalRepository : rentalRepository
com_velora_ui_ProfilePanel --> com_velora_ui_CustomerAccountState : accountState
@enduml
