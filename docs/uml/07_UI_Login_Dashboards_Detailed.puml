    -phoneField : JTextField
    -totalRentalsValue : JLabel
    -activeRentalsValue : JLabel
    -loyaltyPointsValue : JLabel
    -totalSpentValue : JLabel
    -recentRentalsList : JPanel
    -membershipTierValue : JLabel
    -membershipPointsValue : JLabel
    -membershipProgressText : JLabel
