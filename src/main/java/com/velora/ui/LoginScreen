/**
 * Full screen Velora Motors login screen.
 * Put the background image here:
 * src/main/resources/images/velora-dealership.png
 */
public final class LoginScreen extends JFrame {

    public LoginScreen() {
        super("Velora Motors - Manager Login");
        setDefaultCloseOperation(WindowConstants.EXIT_ON_CLOSE);
        setUndecorated(true);
        setMinimumSize(new Dimension(1100, 680));
        setContentPane(new VeloraCanvas(this));
        setExtendedState(JFrame.MAXIMIZED_BOTH);

        getRootPane().registerKeyboardAction(
                e -> dispose(),
                KeyStroke.getKeyStroke(KeyEvent.VK_ESCAPE, 0),
                JComponent.WHEN_IN_FOCUSED_WINDOW
        );
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            try {
                UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
            } catch (Exception ignored) {}
            new LoginScreen().setVisible(true);
        });
    }

    private void toggleMaximize() {
        int state = getExtendedState();
        setExtendedState((state & Frame.MAXIMIZED_BOTH) != 0 ? Frame.NORMAL : Frame.MAXIMIZED_BOTH);
    }

    private static final class VeloraCanvas extends JPanel {
        private static final Color GOLD = new Color(214, 168, 91);
        private static final Color PALE = new Color(236, 203, 157);
        private static final Color WHITE = new Color(248, 248, 248);
        private static final Color MUTED = new Color(170, 176, 186);
        private static final Color STROKE = new Color(214, 168, 91, 70);

        private final LoginScreen frame;
        private final BufferedImage bg;

        private final JTextField username = new RoundTextField("Enter your username", false);
        private final JPasswordField password = new RoundTextField("Enter your password", true);
        private final JCheckBox remember = new JCheckBox("Remember Me", true);
        private final JButton forgot = ghostButton("Forgot Password?");
        private final JButton signIn = new GoldButton("SIGN IN      →");
        private final JButton min = topButton("—");
        private final JButton max = topButton("□");
        private final JButton close = topButton("×");
        private final JButton explore = ghostButton("EXPLORE NOW   ›");

        private final long start = System.nanoTime();
        private float intro = 0f;
        private float statProgress = 0f;
        private int failed = 0;
        private int lockSeconds = 0;

        VeloraCanvas(LoginScreen frame) {
            this.frame = frame;
            this.bg = loadImage("/images/velora-dealership.png");
            setLayout(null);
            setOpaque(true);

            remember.setOpaque(false);
            remember.setForeground(WHITE);
            remember.setFont(new Font("Segoe UI", Font.PLAIN, 12));
            remember.setFocusPainted(false);
            remember.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));

            forgot.setForeground(PALE);
            forgot.setFont(new Font("Segoe UI", Font.PLAIN, 11));
            forgot.addActionListener(e -> JOptionPane.showMessageDialog(this, "Please contact your administrator."));

            signIn.addActionListener(e -> authenticate());
            password.addActionListener(e -> authenticate());

            min.addActionListener(e -> frame.setState(Frame.ICONIFIED));
            max.addActionListener(e -> frame.toggleMaximize());
            close.addActionListener(e -> frame.dispose());

            explore.setForeground(WHITE);
            explore.setBorder(BorderFactory.createLineBorder(new Color(214, 168, 91, 100)));

            add(username);
            add(password);
            add(remember);
            add(forgot);
            add(signIn);
            add(min);
            add(max);
            add(close);
            add(explore);

            addComponentListener(new ComponentAdapter() {
                @Override
                public void componentResized(ComponentEvent e) {
                    layoutControls();
                }
            });

            Timer timer = new Timer(16, e -> {
                float t1 = Math.min(1f, (System.nanoTime() - start) / 750_000_000f);
                float t2 = Math.min(1f, (System.nanoTime() - start) / 1_450_000_000f);
                intro = ease(t1);
                statProgress = ease(t2);
                repaint();
            });
            timer.setCoalesce(true);
            timer.start();
        }

        private void authenticate() {
            if (lockSeconds > 0) return;

            String u = username.getText().trim();
            String p = new String(password.getPassword());

            if (u.equalsIgnoreCase("manager") && p.equals("velora2026")) {
                JOptionPane.showMessageDialog(this, "Welcome to Velora Motors Management System.");
                return;
            }

            failed++;

            if (failed >= 3) {
                lockSeconds = 30;
                signIn.setEnabled(false);

                Timer countdown = new Timer(1000, null);
                countdown.addActionListener(e -> {
                    lockSeconds--;
                    if (lockSeconds <= 0) {
                        failed = 0;
                        signIn.setEnabled(true);
                        countdown.stop();
                    }
                    repaint();
                });
                countdown.start();
            }
        }

        private void layoutControls() {
            int w = getWidth();
            int h = getHeight();
            if (w <= 0 || h <= 0) return;

            int loginX = (int) (w * 0.665);
            int loginY = (int) (h * 0.030);
            int loginW = (int) (w * 0.300);
            int loginH = (int) (h * 0.700);

            loginW = clamp(loginW, 385, 520);
            loginH = clamp(loginH, 500, 670);

            int ctrlW = scaleW(36);
            int ctrlY = Math.max(6, loginY - scaleH(24));

            close.setBounds(w - scaleW(56), ctrlY, ctrlW, scaleH(24));
            max.setBounds(w - scaleW(92), ctrlY, ctrlW, scaleH(24));
            min.setBounds(w - scaleW(128), ctrlY, ctrlW, scaleH(24));

            int px = loginX + (int) (loginW * 0.105);
            int fieldW = loginW - (int) (loginW * 0.210);
            int fieldH = clamp((int) (h * 0.047), 34, 48);

            int userY = loginY + (int) (loginH * 0.340);

            username.setBounds(px, userY, fieldW, fieldH);
            password.setBounds(px, userY + scaleH(74), fieldW, fieldH);

            remember.setBounds(px, userY + scaleH(124), fieldW / 2, scaleH(28));
            forgot.setBounds(px + fieldW / 2, userY + scaleH(124), fieldW / 2, scaleH(28));
            signIn.setBounds(px, userY + scaleH(164), fieldW, clamp((int) (h * 0.055), 42, 56));

            int featuredX = loginX;
            int featuredY = Math.min(h - scaleH(185), loginY + loginH + scaleH(14));
            int featuredW = loginW;
            int featuredH = clamp((int) (h * 0.165), 128, 160);

            explore.setBounds(
                    featuredX + scaleW(24),
                    featuredY + featuredH - scaleH(52),
                    scaleW(145),
                    scaleH(34)
            );
        }

        @Override
        protected void paintComponent(Graphics raw) {
            super.paintComponent(raw);

            Graphics2D g = (Graphics2D) raw.create();
            g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

            int w = getWidth();
            int h = getHeight();

            drawBackground(g, w, h);
            drawHero(g, w, h);
            drawLoginCard(g, w, h);
            drawFeatured(g, w, h);
            drawFooter(g, w, h);

            g.dispose();
        }

        private void drawBackground(Graphics2D g, int w, int h) {
            if (bg != null) {
                double s = Math.max(w / (double) bg.getWidth(), h / (double) bg.getHeight());
                int bw = (int) Math.ceil(bg.getWidth() * s);
                int bh = (int) Math.ceil(bg.getHeight() * s);
                int x = (w - bw) / 2;
                int y = (h - bh) / 2;
                g.drawImage(bg, x, y, bw, bh, null);
            } else {
                g.setPaint(new GradientPaint(0, 0, new Color(2, 6, 12), w, h, new Color(0, 0, 0)));
                g.fillRect(0, 0, w, h);
            }

            g.setPaint(new GradientPaint(0, 0, new Color(0, 0, 0, 35), w, 0, new Color(0, 0, 0, 145)));
            g.fillRect(0, 0, w, h);

            g.setPaint(new GradientPaint(0, 0, new Color(0, 0, 0, 0), 0, h, new Color(0, 0, 0, 100)));
            g.fillRect(0, 0, w, h);
        }

        private void drawHero(Graphics2D g, int w, int h) {
            Composite old = g.getComposite();
            g.setComposite(AlphaComposite.SrcOver.derive(Math.max(0.08f, intro)));

            int brandX = (int) (w * 0.035);
            int brandY = (int) (h * 0.040);
            int brandW = (int) (w * 0.405);
            drawBrand(g, brandX, brandY, brandW);

            int trustX = (int) (w * 0.335);
            int trustY = (int) (h * 0.080);
            int trustW = (int) (w * 0.315);
            int trustH = (int) (h * 0.185);
            drawTrustPanel(g, trustX, trustY, trustW, trustH);

            int signX = (int) (w * 0.252);
            int signY = (int) (h * 0.400);
            int signW = (int) (w * 0.205);
            int signH = (int) (h * 0.062);

            drawGlass(g, signX, signY, signW, signH, 14, 125);
            drawBMW(g, signX + scaleW(18), signY + scaleH(9), scaleW(36));
            drawFit(
                    g,
                    "VELORA MOTORS",
                    signX + scaleW(62),
                    signY + signH / 2 + scaleH(8),
                    signW - scaleW(80),
                    new Font("Segoe UI", Font.PLAIN, scaleFont(21)),
                    WHITE,
                    false
            );

            int featureY = (int) (h * 0.535);
            int featureX = (int) (w * 0.035);
            int featureW = (int) (w * 0.610);
            int featureH = (int) (h * 0.115);

            drawFeatures(g, featureX, featureY, featureW, featureH);

            int quoteY = featureY + featureH + scaleH(10);
            int quoteW = (int) (featureW * 0.420);
            int statsW = featureW - quoteW;

            drawQuote(g, featureX, quoteY, quoteW, scaleH(64));
            drawStats(g, featureX + quoteW, quoteY, statsW, scaleH(64));

            g.setComposite(old);
        }

