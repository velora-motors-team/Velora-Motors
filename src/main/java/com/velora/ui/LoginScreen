        private void drawGlass(Graphics2D g, int x, int y, int w, int h, int r, int alpha) {
            g.setColor(new Color(5, 10, 16, alpha));
            g.fillRoundRect(x, y, w, h, r, r);

            g.setColor(STROKE);
            g.drawRoundRect(x, y, w, h, r, r);
        }

        private void drawBMW(Graphics2D g, int x, int y, int size) {
            int r = size / 2;

            g.setColor(WHITE);
            g.fillOval(x, y, size, size);

            g.setColor(new Color(4, 8, 13));
            g.fillOval(x + scaleW(4), y + scaleW(4), size - scaleW(8), size - scaleW(8));

            int inset = scaleW(12);
            int d = size - inset * 2;
            int xx = x + inset;
            int yy = y + inset;

            g.setColor(WHITE);
            g.fillArc(xx, yy, d, d, 0, 90);
            g.fillArc(xx, yy, d, d, 180, 90);

            g.setColor(new Color(20, 126, 199));
            g.fillArc(xx, yy, d, d, 90, 90);
            g.fillArc(xx, yy, d, d, 270, 90);

            g.setColor(new Color(255, 255, 255, 200));
            g.setStroke(new BasicStroke(scaleStroke(2f)));
            g.drawOval(xx, yy, d, d);
        }

        private void drawWings(Graphics2D g, int cx, int y, double s) {
            Graphics2D gg = (Graphics2D) g.create();

            gg.translate(cx, y);
            gg.scale(s, s);
            gg.setColor(GOLD);
            gg.setStroke(new BasicStroke(4f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));

            Path2D p = new Path2D.Double();

            p.moveTo(0, 55);
            p.lineTo(-37, 0);
            p.lineTo(-105, 0);

            p.moveTo(0, 55);
            p.lineTo(37, 0);
            p.lineTo(105, 0);

            p.moveTo(-28, 13);
            p.lineTo(-86, 13);

            p.moveTo(28, 13);
            p.lineTo(86, 13);

            p.moveTo(-19, 26);
            p.lineTo(-63, 26);

            p.moveTo(19, 26);
            p.lineTo(63, 26);

            gg.draw(p);
            gg.dispose();
        }

        private void drawSmallIcon(Graphics2D g, String type, int cx, int cy, int size) {
            g.setColor(GOLD);
            g.setStroke(new BasicStroke(scaleStroke(2f), BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));

            int s = size;

            if ("shield".equals(type)) {
                drawShieldIcon(g, cx, cy, s);
            } else if ("calendar".equals(type)) {
                g.drawRoundRect(cx - s / 2, cy - s / 2, s, s, 3, 3);
                g.drawLine(cx - s / 2, cy - s / 5, cx + s / 2, cy - s / 5);
                g.drawLine(cx - s / 4, cy - s / 2 - 3, cx - s / 4, cy - s / 3);
                g.drawLine(cx + s / 4, cy - s / 2 - 3, cx + s / 4, cy - s / 3);
            } else if ("star".equals(type)) {
                Path2D star = new Path2D.Double();

                for (int i = 0; i < 10; i++) {
                    double a = -Math.PI / 2 + i * Math.PI / 5;
                    double rr = (i % 2 == 0) ? s / 2.0 : s / 4.0;
                    double px = cx + Math.cos(a) * rr;
                    double py = cy + Math.sin(a) * rr;

                    if (i == 0) {
                        star.moveTo(px, py);
                    } else {
                        star.lineTo(px, py);
                    }
                }

                star.closePath();
                g.draw(star);
            } else if ("tag".equals(type)) {
                Path2D tag = new Path2D.Double();

                tag.moveTo(cx - s / 2, cy - s / 7);
                tag.lineTo(cx, cy - s / 2);
                tag.lineTo(cx + s / 2, cy);
                tag.lineTo(cx, cy + s / 2);
                tag.closePath();

                g.draw(tag);
                g.fillOval(cx - s / 8, cy - s / 4, 4, 4);
            } else if ("car".equals(type)) {
                g.drawRoundRect(cx - s / 2, cy - s / 6, s, s / 3, 4, 4);
                g.drawLine(cx - s / 3, cy - s / 6, cx - s / 5, cy - s / 2);
                g.drawLine(cx - s / 5, cy - s / 2, cx + s / 4, cy - s / 2);
                g.drawLine(cx + s / 4, cy - s / 2, cx + s / 2, cy - s / 6);
                g.fillOval(cx - s / 3, cy + s / 6, s / 6, s / 6);
                g.fillOval(cx + s / 5, cy + s / 6, s / 6, s / 6);
            }
        }

        private void drawFieldIcon(Graphics2D g, int x, int y, String type) {
            g.setColor(new Color(215, 220, 228));
            g.setStroke(new BasicStroke(scaleStroke(1.7f)));

            if ("user".equals(type)) {
                g.drawOval(x, y, scaleW(10), scaleW(10));
                g.drawArc(x - scaleW(5), y + scaleH(13), scaleW(20), scaleH(15), 0, 180);
            } else {
                g.drawRoundRect(x - scaleW(2), y + scaleH(9), scaleW(16), scaleH(16), 3, 3);
                g.drawArc(x + scaleW(1), y, scaleW(10), scaleH(17), 0, 180);
            }
        }

        private void drawShieldIcon(Graphics2D g, int cx, int cy, int s) {
            Path2D p = new Path2D.Double();

            p.moveTo(cx, cy - s / 2.0);
            p.lineTo(cx + s / 2.0, cy - s / 4.0);
            p.lineTo(cx + s / 3.0, cy + s / 3.0);
            p.lineTo(cx, cy + s / 2.0);
            p.lineTo(cx - s / 3.0, cy + s / 3.0);
            p.lineTo(cx - s / 2.0, cy - s / 4.0);
            p.closePath();

            g.draw(p);
            g.drawLine(cx, cy - s / 4, cx, cy + s / 4);
            g.drawLine(cx - s / 5, cy, cx + s / 5, cy);
        }

        private void drawAlertIcon(Graphics2D g, int cx, int cy) {
            g.setColor(new Color(240, 68, 76));
            g.setStroke(new BasicStroke(scaleStroke(2f)));
            g.drawOval(cx - scaleW(12), cy - scaleW(12), scaleW(24), scaleW(24));
            g.drawLine(cx, cy - scaleH(7), cx, cy + scaleH(3));
            g.fillOval(cx - 2, cy + scaleH(7), 4, 4);
        }

        private void drawFitCentered(Graphics2D g, String text, int cx, int y, int maxW, Font font, Color color) {
            Font f = fitFont(g, text, font, maxW);

            g.setFont(f);
            g.setColor(color);

            int tw = g.getFontMetrics().stringWidth(text);
            g.drawString(text, cx - tw / 2, y);
        }

        private void drawFit(Graphics2D g, String text, int x, int y, int maxW, Font font, Color color, boolean right) {
            Font f = fitFont(g, text, font, maxW);

            g.setFont(f);
            g.setColor(color);

            int tw = g.getFontMetrics().stringWidth(text);
            g.drawString(text, right ? x + maxW - tw : x, y);
        }

        private Font fitFont(Graphics2D g, String text, Font font, int maxW) {
            Font f = font;

            while (f.getSize() > 8) {
                g.setFont(f);

                if (g.getFontMetrics().stringWidth(text) <= maxW) {
                    return f;
                }

                f = f.deriveFont((float) f.getSize() - 1f);
            }

            return f;
        }

        private int scaleW(int v) {
            return Math.max(1, Math.round(v * getWidth() / 1536f));
        }

        private int scaleH(int v) {
            return Math.max(1, Math.round(v * getHeight() / 960f));
        }

        private int scaleFont(int v) {
            float s = Math.min(getWidth() / 1536f, getHeight() / 960f);
            return Math.max(8, Math.round(v * s));
        }

        private float scaleStroke(float v) {
            float s = Math.min(getWidth() / 1536f, getHeight() / 960f);
            return Math.max(1f, v * s);
        }

        private static int clamp(int v, int min, int max) {
            return Math.max(min, Math.min(max, v));
        }

        private static float ease(float p) {
            return 1f - (1f - p) * (1f - p) * (1f - p);
        }

        private static BufferedImage loadImage(String path) {
            try {
                return ImageIO.read(VeloraCanvas.class.getResource(path));
            } catch (IOException | IllegalArgumentException e) {
                return null;
            }
        }

