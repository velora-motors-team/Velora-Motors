        private void drawStats(Graphics2D g, int x, int y, int w, int h) {
            drawGlass(g, x, y, w, h, 12, 120);

            String[] value = {
                    ((int) (250 * statProgress)) + "+",
                    statProgress > .995f ? "15K+" : String.format("%.0fK+", 15 * statProgress),
                    ((int) (25 * statProgress)) + "+",
                    String.format("%.1f/5", 4.9 * statProgress)
            };

            String[] label = {
                    "Premium Vehicles",
                    "Satisfied Customers",
                    "Locations",
                    "Customer Rating"
            };

            int cell = w / 4;

            for (int i = 0; i < 4; i++) {
                int cx = x + i * cell + cell / 2;
                drawFitCentered(g, value[i], cx, y + scaleH(31), cell, new Font("Segoe UI", Font.BOLD, scaleFont(20)), WHITE);
                drawFitCentered(g, label[i], cx, y + scaleH(55), cell, new Font("Segoe UI", Font.PLAIN, scaleFont(10)), new Color(106, 140, 192));
            }
        }

        private void drawLoginCard(Graphics2D g, int w, int h) {
            int x = (int) (w * 0.665);
            int y = (int) (h * 0.030);
            int cw = clamp((int) (w * 0.300), 385, 520);
            int ch = clamp((int) (h * 0.700), 500, 670);

            drawGlass(g, x, y, cw, ch, 24, 184);

            int cx = x + cw / 2;

            drawBMW(g, cx - scaleW(31), y + scaleH(28), scaleW(62));

            drawFitCentered(
                    g,
                    "M A N A G E R   L O G I N",
                    cx,
                    y + scaleH(140),
                    cw - scaleW(40),
                    new Font("Segoe UI", Font.PLAIN, scaleFont(27)),
                    PALE
            );

            drawFitCentered(
                    g,
                    "Welcome back! Please sign in to continue.",
                    cx,
                    y + scaleH(177),
                    cw - scaleW(40),
                    new Font("Segoe UI", Font.PLAIN, scaleFont(13)),
                    WHITE
            );

            g.setColor(new Color(214, 168, 91, 170));
            g.drawLine(cx - scaleW(28), y + scaleH(194), cx + scaleW(28), y + scaleH(194));

            int px = x + (int) (cw * 0.105);
            int labelY = y + (int) (ch * 0.318);

            g.setFont(new Font("Segoe UI", Font.PLAIN, scaleFont(12)));
            g.setColor(WHITE);
            g.drawString("USERNAME", px, labelY);
            g.drawString("PASSWORD", px, labelY + scaleH(74));

            drawFieldIcon(g, px + scaleW(13), labelY + scaleH(18), "user");
            drawFieldIcon(g, px + scaleW(13), labelY + scaleH(92), "lock");

            drawNotice(g, x + (int) (cw * .105), y + (int) (ch * .615), cw - (int) (cw * .210), scaleH(58), false);
            drawNotice(g, x + (int) (cw * .105), y + (int) (ch * .735), cw - (int) (cw * .210), scaleH(74), true);
        }

        private void drawNotice(Graphics2D g, int x, int y, int w, int h, boolean error) {
            g.setColor(error ? new Color(95, 9, 16, 220) : new Color(7, 13, 19, 220));
            g.fillRoundRect(x, y, w, h, scaleW(8), scaleW(8));

            g.setColor(error ? new Color(240, 68, 76) : WHITE);
            g.setFont(new Font("Segoe UI", Font.PLAIN, scaleFont(11)));

            if (error) {
                String sec = lockSeconds > 0 ? lockSeconds + " seconds" : "30 seconds";
                g.drawString("Too many failed attempts.", x + scaleW(46), y + scaleH(27));
                g.drawString("Wait " + sec + " before trying again.", x + scaleW(46), y + scaleH(50));
                drawAlertIcon(g, x + scaleW(22), y + scaleH(35));
            } else {
                g.drawString("For your security, session expires", x + scaleW(46), y + scaleH(25));
                g.drawString("after 10 minutes of inactivity.", x + scaleW(46), y + scaleH(47));
                drawShieldIcon(g, x + scaleW(22), y + scaleH(31), scaleW(24));
            }
        }

        private void drawFeatured(Graphics2D g, int w, int h) {
